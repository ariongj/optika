Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType model/gltf-binary .glb
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # Only an explicitly requested index.html redirects; internal DirectoryIndex does not.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[?\s] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]
  RewriteRule ^examination/?$ /ekzaminimi/ [R=301,L,NE]
  RewriteRule ^(?:guides|lens-technology|lens-oculus)/?$ /lens-focus/ [R=301,L,NE]
  RewriteRule ^(?:fit-studio|matje-online)/?$ /virtual-try-on/ [R=301,L,NE]
  RewriteRule ^(?:brand|crafted)/?$ /laboratory/ [R=301,L,NE]
  RewriteRule ^operations/?$ /staff/ [R=301,L,NE]
  # Canonicals are single-hop directory URLs; PHP keeps CMS SEO and stock current.
  RewriteRule ^(optical|clinic|shop|sunglasses|prescription-glasses|ekzaminimi|lens-focus|virtual-try-on|laboratory(?:/partners|/kosovo|/europe)?|about|contact|policies|order-status|wishlist|account|staff)$ /$1/ [R=301,L,NE]
  RewriteRule ^sitemap\.xml$ api/seo.php?route=sitemap.xml [END,QSA]
  RewriteRule ^(syze-dielli|syze-optike)/([^/]+)/?$ api/seo.php?route=$1/$2 [END,QSA]
  RewriteRule ^(optical|clinic|shop|sunglasses|prescription-glasses|ekzaminimi|lens-focus|virtual-try-on|laboratory(?:/partners|/kosovo|/europe)?|about|contact|policies|order-status|wishlist|account|staff)/$ api/seo.php?route=$1 [END,QSA]
  RewriteRule ^$ api/seo.php?route= [END,QSA]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  SetEnvIf Request_URI "^/(?:api|uploads|lens-focus-hero)/" OPTIKA_NOINDEX
  Header always set X-Robots-Tag "noindex, nofollow" env=OPTIKA_NOINDEX
  <Files "seo-pages.json">
    Header set X-Robots-Tag "noindex, nofollow"
    Header set Cache-Control "no-cache"
  </Files>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), geolocation=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'"

  <FilesMatch "\.(?:js|css|woff|woff2|wasm|glb)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:avif|gif|ico|jpe?g|png|svg|webp|mp3|wav|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^(?:index\.html|manifest\.webmanifest|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
