# Miftari Vision — web root (public_html) for Apache / LiteSpeed (Hostinger).
# The site is a single-page app: built pages are plain files, /api/ is the PHP backend (api/.htaccess), /uploads/
# holds CMS pictures (uploads/.htaccess). TLS versions and cipher suites are set by the host, not here.

Options -Indexes
DirectoryIndex index.html
# Routes known at build time have their own <route>/index.html; anything else (e.g. a product added later in the CMS)
# gets the app shell with HTTP 404, the same way the GitHub Pages version works today.
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/manifest+json .webmanifest
  AddType application/octet-stream .task
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Plain HTTP → HTTPS (keep Hostinger's own "Force HTTPS" switch on as well; the two do not conflict).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # Optional: one host name only. Uncomment ONE pair after both names have a valid certificate.
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

  # Never serve dot-files (except /.well-known/ for certificates), backups, archives or databases.
  RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
  RewriteRule \.(?:zip|tar|t?gz|7z|rar|sql|sqlite|sqlite3|db|bak|old|orig|swp|log|ini|env|sh|md)$ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
  # Same policy as the <meta> in every page (vite.config.ts) plus what only a header can do (frame-ancestors).
  # The only places the site talks to are this server, the self-hosted try-on runtime (wasm, blob:) and the camera.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: data:; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; frame-ancestors 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # HTTPS only for this host name for a year. No includeSubDomains (not every subdomain has been checked) and no
  # preload (needs the owner's explicit approval). Browsers ignore this header on plain-HTTP responses.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header unset X-Powered-By

  # Keep the CMS, the API and uploaded pictures out of search results.
  SetEnvIf Request_URI "^/(?:admin|api|uploads)(?:/|$)" MV_NOINDEX
  Header always set X-Robots-Tag "noindex, nofollow" env=MV_NOINDEX

  # Build files under /assets/ carry a content hash in their name, so they never change: cached for a year. Other
  # static files (pictures, fonts, the try-on runtime) for a week. Pages, the service worker and the manifest are
  # always re-checked, so a new release shows up on the next visit.
  SetEnvIf Request_URI "^/assets/" MV_HASHED
  <FilesMatch "\.(?:js|css|woff2?|wasm|task|avif|gif|ico|jpe?g|png|svg|webp|mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
    Header set Cache-Control "public, max-age=31536000, immutable" env=MV_HASHED
  </FilesMatch>
  <FilesMatch "^(?:index\.html|404\.html|sw\.js|manifest\.webmanifest|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/calendar
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json application/manifest+json
  AddOutputFilterByType DEFLATE application/wasm image/svg+xml
</IfModule>
