# Miftari Vision API: every /api/<route> request goes to index.php; code, data and settings files are never served.
# (Rewrite rules here replace the web root's, so the HTTPS redirect is repeated.)
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
  RewriteRule ^(lib|storage|tests)(/|$) - [F,L]
  RewriteRule ^index\.php$ - [L]
  RewriteRule ^(.*)$ index.php?r=$1 [QSA,L]
</IfModule>
<FilesMatch "\.(json|sqlite|log|txt|md|bak|ini|sh)$|^config\.php$">
  Require all denied
</FilesMatch>
